HOST=127.0.0.1
PORT=5050
# Set two distinct random 32+ character secrets in .env before startup.
LEADCOLLECTOR_AGENT_TOKEN=
LEADCOLLECTOR_WORKER_TOKEN=
# Optional absolute local paths. See docs/WINDOWS_SETUP.md.
# LEADCOLLECTOR_STATE_DIR=C:/Users/you/AppData/Local/EvoMesh/LeadCollector
# LEADCOLLECTOR_EXPORT_DIR=C:/Dev/EvoMesh/workspace/agents/lead-researcher/playground/exports
# LEADCOLLECTOR_MAX_ACTIVE=1
# LEADCOLLECTOR_MAX_PENDING=25
# LEADCOLLECTOR_MAX_ATTEMPTS=2
# LEADCOLLECTOR_LEASE_SECONDS=90
# LEADCOLLECTOR_JOB_RETENTION_DAYS=30
# EXTRACT_TIMEOUT=12000
# EXTRACT_CONCURRENCY=3
# LEADCOLLECTOR_ENRICH_PARALLEL=1   # jobs enriched side by side, one site each; keep <= EXTRACT_CONCURRENCY
# LEADCOLLECTOR_DC_PLAIN_BATCH=1    # Data Collector: POST /records/batch, many records per write
# LEADCOLLECTOR_DC_BATCH_SIZE=50    # records per batch request (max 500)
# EXTRACT_DEFAULT_COUNTRY=DE
# ALLOWED_ORIGINS=chrome-extension://<additional unpacked ID>
# Marketing audits (modules/audits)
# LEADCOLLECTOR_AUDIT_DIR=C:/path/to/audits          # report.pdf, report.html, audit.json per audit
# LEADCOLLECTOR_BRAND_FILE=C:/path/to/brand.json     # {"name","website","email","phone","location","accent","logo_path","tagline":{"en","bg"}}
# LEADCOLLECTOR_PSI_KEY=                             # Google PageSpeed Insights key; without it Lighthouse runs locally
# LEADCOLLECTOR_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe
# LEADCOLLECTOR_DC_COLLECTION_AUDIT=                 # Data Collector collection for marketing_audit records
# LEADCOLLECTOR_CAMPAIGN_INFLIGHT=8                  # campaign searches in flight (one in the browser)
